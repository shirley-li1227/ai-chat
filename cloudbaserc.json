{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "version": "2.1",
  "envId": "lucky-lxy-d1g5yv28gd1a13d29",
  "functionRoot": "./functions",
  "functions": [
    {
      "name": "api",
      "type": "HTTP",
      "runtime": "Nodejs20.19",
      "timeout": 300,
      "memorySize": 256,
      "public": true,
      "gatewayPath": "/api",
      "installDependency": true,
      "ignore": [
        "node_modules",
        ".git",
        "src",
        "data",
        "test",
        "evals",
        "dist/tsconfig.*",
        "tsconfig.json",
        "tsconfig.build.json",
        "nest-cli.json",
        ".env",
        ".env.local",
        "*.log"
      ],
      "envVariables": {
        "NODE_ENV": "production",
        "PORT": "9000",
        "CORS_ORIGINS": "",
        "LLM_API_KEY": "{{env.LLM_API_KEY}}",
        "AGENT_MAX_TURNS": "6",
        "AGENT_TOOL_CONCURRENCY": "4",
        "CONTEXT_TOKEN_BUDGET": "6000",
        "THROTTLE_TTL": "60000",
        "THROTTLE_LIMIT": "10",
        "FETCH_TIMEOUT_MS": "15000",
        "FETCH_MAX_BYTES": "1048576",
        "FETCH_ALLOWED_HOSTS": ""
      }
    }
  ]
}
