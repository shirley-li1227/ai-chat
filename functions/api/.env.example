# 后端环境变量样例。复制为 .env 后按需修改；.env 与 .env.local 都已被 git 忽略。
# 只有本地开发可以直接抄默认值；生产必须显式提供 ENCRYPTION_KEY 与数据库连接信息。

# --- 运行模式 ---
NODE_ENV=development
PORT=3001
# 跨域响应头由网关注入时保持为空，填了会与网关各加一份 Access-Control-Allow-Origin 导致浏览器拦截
CORS_ORIGINS=

# --- 鉴权 ---
# true 才走真实登录（注册/登录/会话 token）；缺省或任何非 'true' 的值都是免登录：
# 所有请求统一以后端最早创建的那个账号身份执行，已有配置与历史会话直接可见，空库时自动建 demo 账号。
# 免登录等于把 /api/chat 与 /api/config 开放给任何能访问域名的人——大模型配额与 API Key 由访问者共用，
# 只剩 IP 限流兜底。对外部署前先确认能接受这一点，把本项设为 true 即可回到真实登录，代码无需改动。
AUTH_ENABLED=false

# --- 数据层 ---
# 本地/演示：sqljs（零依赖，代价是每个实例一份私有数据，见 README「已知局限」）
# 正式：postgres
DB_TYPE=sqljs
DB_LOCATION=data/app.db
DB_SYNCHRONIZE=true
# 仅 DB_TYPE=postgres 需要；生产环境 synchronize 默认关闭，改实体后要手动跑迁移
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_SSL=false

# --- 密钥 ---
# 加密落库的大模型 API Key 用，必须是 64 位十六进制（32 字节）。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 缺失或格式非法时保存 Key 会返回 400，后端不会降级成明文存储
ENCRYPTION_KEY=

# --- Agent 决策循环 ---
AGENT_MAX_TURNS=6
AGENT_TOOL_CONCURRENCY=4

# --- 上下文窗口 ---
CONTEXT_TOKEN_BUDGET=6000
CONTEXT_SUMMARY_ENABLED=true

# --- 模型路由（同一份配置内按场景选模型） ---
# 候选档位**从低到高**逗号分隔。这里只是**兜底**：每份配置里的「模型档位候选」有值就以配置为准，
# 留空才读到这里；两处都空等于不开启，回答恒用配置里的主力模型。
# 为什么优先放在配置里：候选名属于某一家，全局变量分不出「这几档是谁家的」，切到另一家就会拿 4xx。
# 模型名不写死在代码里：供应商的 id 会换，用户也未必开通了高那一档
MODEL_ROUTING_CANDIDATES=
# false 则只按主力模型作答，用于对比测试或排障
MODEL_ROUTING_ENABLED=true

# --- 跨会话长期记忆 ---
# 缺省开启，只认字面 'false'：关掉后不再向模型广播 remember/forget，也不再往 system 注入任何记忆
MEMORY_ENABLED=true
# 单条记忆的字数上限（钳在 40~500）：超过这个长度的一般是任务上下文，不是长期事实
MEMORY_ITEM_MAX_CHARS=200
# 每个身份最多留多少条（钳在 5~500），超出按最后更新时间淘汰最旧的
MEMORY_MAX_ENTRIES=100
# 注入 system 的字符预算（钳在 200~4000）：宁可少带几条，也不让记忆吃掉上下文窗口
MEMORY_INJECT_MAX_CHARS=1500

# --- 后台任务（执行器未部署时保持关闭） ---
# false 时不向模型广播 run_in_background，接口仍可提交任务但会一直停在 queued
BACKGROUND_TASKS_ENABLED=false
# 执行器存活证明有效期：进程崩溃后最长被占用这么久，之后别的实例可抢占
TASK_LEASE_MS=120000
# 单个任务最多执行几次（含首次），超过判失败，不再无限重投
TASK_MAX_ATTEMPTS=3
# 领取时一次扫描的候选条数上限
TASK_CLAIM_SCAN=20
TASK_PAYLOAD_MAX_BYTES=8192
TASK_RESULT_MAX_CHARS=20000

# --- 限流（进程内存计数，仅 NODE_ENV=production 生效） ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# --- fetch_url 工具 ---
FETCH_TIMEOUT_MS=15000
FETCH_MAX_BYTES=1048576
# 非空时作为抓取域名白名单（逗号分隔）
FETCH_ALLOWED_HOSTS=
