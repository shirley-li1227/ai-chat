{
  "name": "ai-chat",
  "private": true,
  "version": "0.0.0",
  "description": "AI 聊天助手：frontend/ 为 Vite + React 前端，functions/api/ 为 NestJS HTTP 云函数后端",
  "scripts": {
    "install:all": "npm --prefix frontend install && npm --prefix functions/api install",
    "dev": "npm --prefix frontend run dev",
    "dev:api": "npm --prefix functions/api run start:dev",
    "build": "npm run build:frontend && npm run build:api",
    "build:frontend": "npm --prefix frontend run build",
    "build:api": "npm --prefix functions/api run build",
    "start:api": "npm --prefix functions/api run start:prod",
    "preview": "npm --prefix frontend run preview",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix functions/api run typecheck",
    "eval": "npm --prefix functions/api run eval",
    "eval:online": "npm --prefix functions/api run eval:online"
  }
}
